# beliq MCP server configuration (set these in your MCP client's server env).

# Required. Create a key in the beliq dashboard under API Keys.
BELIQ_API_KEY=

# Optional. How the key is sent: "header" (X-API-Key, default) or "bearer"
# (Authorization: Bearer).
BELIQ_AUTH=header

# Optional. Override only for a self-hosted deployment; defaults to the
# production API.
BELIQ_BASE_URL=https://api.beliq.eu

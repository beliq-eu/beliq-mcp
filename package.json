{
  "name": "beliq-mcp",
  "version": "0.4.1",
  "description": "beliq MCP server: validate, parse, generate, and convert EU e-invoices (XRechnung, ZUGFeRD, Factur-X, Peppol BIS) for MCP clients. Every verdict carries the check depth the API states, or says that none was stated.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "beliq",
    "email": "hello@beliq.eu"
  },
  "homepage": "https://beliq.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beliq-eu/beliq-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/beliq-eu/beliq-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "beliq",
    "e-invoice",
    "einvoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "peppol",
    "en16931",
    "validation",
    "compliance"
  ],
  "engines": {
    "node": ">=20.15"
  },
  "bin": {
    "beliq-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --exclude test/integration.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "scrub:check": "bash scripts/scrub-check.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@beliq/sdk": "^0.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.0"
  }
}
